# Copy this file to .env.local for local development, or set these variables
# in your hosting provider's dashboard. Never commit real values.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public origin of the live site, without a trailing slash. Used for canonical
# URLs, the sitemap, robots.txt, structured data and social sharing previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Contact form delivery
# ---------------------------------------------------------------------------
# Configure at least ONE channel below. With none configured the form tells
# visitors plainly that their message was not sent (HTTP 503); it never
# pretends to succeed. Every configured channel is attempted.

# Where enquiries are delivered, and the sender address shown on them.
# The "from" address must be on a domain your email provider lets you send from.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Option A: SMTP (Google Workspace, Microsoft 365, Zoho, Amazon SES, ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to true on port 465, otherwise false (STARTTLS).
SMTP_SECURE=

# Option B: Resend (https://resend.com) HTTP API
RESEND_API_KEY=

# Option C: Webhook. Receives the enquiry as a JSON POST, for a CRM, Slack
# workflow, Zapier, Make, n8n or your own service.
CONTACT_WEBHOOK_URL=
# Optional shared secret, sent as the "X-Webhook-Secret" request header.
CONTACT_WEBHOOK_SECRET=
