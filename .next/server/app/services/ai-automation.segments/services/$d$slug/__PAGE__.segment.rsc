2f:["$","$L15",null,{"className":"mt-12 grid gap-x-10 gap-y-3 border-l-4 border-accent bg-paper p-7 md:p-9 lg:grid-cols-12","children":[["$","h3",null,{"className":"type-h3 lg:col-span-4","children":"What we don't promise"}],["$","p",null,{"className":"leading-relaxed text-ink-soft lg:col-span-8","children":"AI systems make mistakes, and no responsible automation is fully autonomous or error-free. We design for that: confidence thresholds, human review for consequential steps, logging, and a clear way to correct the system when it is wrong. Expected benefits depend on your process and data, so we assess them with you during discovery rather than quoting a figure up front."}]]}]
