] gap-x-4 border-t border-paper/20 py-8 md:py-10","children":[["$","span",null,{"aria-hidden":"true","className":"font-display text-4xl font-semibold leading-none text-accent-bright","children":3}],["$","div",null,{"children":[["$","h3",null,{"className":"type-h3","children":"People stay in the loop"}],["$","p",null,{"className":"mt-3 max-w-md leading-relaxed text-paper/70","children":"We design automation with review steps and clear logs. Your team keeps control of the decisions that matter."}]]}]]}],["$","$L36","Built to be yours",{"as":"li","className":"grid grid-cols-[3.5rem_1fr] gap-x-4 border-t border-paper/20 py-8 md:py-10","children":[["$","span",null,{"aria-hidden":"true","className":"font-display text-4xl font-semibold leading-none text-accent-bright","children":4}],["$","div",null,{"children":[["$","h3",null,{"className":"type-h3","children":"Built to be yours"}],["$","p",null,{"className":"mt-3 max-w-md leading-relaxed text-paper/70","children":"You receive the source code, documentation and access. The system is built so another team could run it."}]]}]]}]]}]]}]}]
28:["$","section",null,{"className":"shell section-y","aria-labelledby":"faq-heading","children":["$","div",null,{"className":"grid gap-x-10 gap-y-10 lg:grid-cols-12","children":[["$","div",null,{"className":"lg:col-span-4","children":["$","div",null,{"className":"rule-top pt-6 lg:sticky lg:top-28","children":[["$","p",null,{"className":"type-label text-ink-faint","children":"Questions"}],["$","$L1d",null,{"id":"faq-heading","text":"Asked before most projects begin.","className":"type-h2 mt-5"}],["$","$L20",null,{"className":"mt-8","children":["$","$L10",null,{"href":"/faq","className":"group inline-flex items-center gap-2 py-2 text-[0.97rem] font-semibold","children":[["$","span",null,{"className":"link-draw","children":"All frequently asked questions"}],["$","$L11",null,{"ref":"$undefined","icon":"$0:t:t:d:r:props:children:1:props:children:props:children:3:props:children:1:props:children:props:notFound:0:props:children:props:children:1:props:children:3:props:children:0:props:children:1:props:icon","className":"size-4 transition-transform duration-500 ease-expo group-hover:translate-x-1","aria-hidden":"true"}]]}]}]]}]}],["$","$L20",null,{"className":"lg:col-span-8","children":["$","$L47",null,{"items":[{"q":"What does LIPI SOFT do?","a":"We design, build and support business technology: AI automation, custom software, CRM systems, and networking and IT infrastructure. Many projects combine more than one of these, because the problem rarely sits neatly inside a single discipline.","featured":true},{"q":"How does a project start?","a":"With a conversation about the problem. If it looks like a fit, we run a discovery phase to understand your process, systems and constraints, then give you a written scope, approach and estimate before you commit to the build.","featured":true},{"q":"How long does a typical project take?","a":"It depends on scope, the number of systems involved and how quickly decisions can be made. We give a timeline with milestones after discovery, when it can be based on real information, and we do not quote durations before then.","featured":true},{"q":"How do you price your work?","a":"Pricing follows the nature of the work. Well-defined projects can be quoted at a fixed price for an agreed scope. Open-ended or evolving work is usually better suited to time-based billing with regular reporting. We recommend a model after discovery and explain why.","featured":true},{"q":"Will new systems work with the software we already use?","a":"Integration is a normal part of our work. If your existing software offers an API or another supported way to exchange data, we connect to it. If not, we look at alternatives such as file exchange or database-level integration and explain the trade-offs.","featured":true},{"q":"Is AI automation reliable enough for business use?","a":"It can be, when designed with its limits in mind. AI models make mistakes, so we use them for the steps they suit, validate their output with rules, and keep people in the approval loop for anything consequential. We do not describe any automation as error-free.","featured":true}]}]}]]}]}]
