g:type","content":"article"}],["$","meta","16",{"property":"article:published_time","content":"2026-10-12"}],["$","meta","17",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","18",{"name":"twitter:title","content":"Choosing a first process to automate | LIPI SOFT"}],["$","meta","19",{"name":"twitter:description","content":"The best first automation project is rarely the most impressive one. A short checklist for picking a process that will actually pay back."}],["$","meta","20",{"name":"twitter:image","content":"http://localhost:3000/opengraph-image"}],["$","link","21",{"rel":"icon","href":"/icon.svg?icon.3cgwwcapic1oj.svg","sizes":"any","type":"image/svg+xml"}],["$","$L25","22",{}]]}]}],null]}],["$","meta",null,{"name":"next-size-adjust","content":""}]]}],"p":"$@26","v":null,"s":"$8"}},"a":"$@27","u":"$@28","b":"6oEAerG1a93yhX2XsxExF"}
