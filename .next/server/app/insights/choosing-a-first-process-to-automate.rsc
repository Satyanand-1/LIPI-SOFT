20:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"Choosing a first process to automate\",\"description\":\"The best first automation project is rarely the most impressive one. A short checklist for picking a process that will actually pay back.\",\"datePublished\":\"2026-10-12\",\"mainEntityOfPage\":\"http://localhost:3000/insights/choosing-a-first-process-to-automate\",\"author\":{\"@type\":\"Organization\",\"name\":\"LIPI SOFT\",\"url\":\"http://localhost:3000\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"LIPI SOFT\",\"url\":\"http://localhost:3000\"}}"}}],["$","article",null,{"children":[["$","header",null,{"className":"shell pb-10 pt-28 md:pb-14 md:pt-36","children":[["$","div",null,{"className":"animate-fade-up","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"http://localhost:3000\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Insights\",\"item\":\"http://localhost:3000/insights\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Choosing a first process to automate\",\"item\":\"http://localhost:3000/insights/choosing-a-first-process-to-automate\"}]}"}}],["$","nav",null,{"aria-label":"Breadcrumb","className":"type-label text-ink-faint","children":["$","ol",null,{"className":"flex flex-wrap items-center gap-x-2 gap-y-1","children":[["$","li","/",{"className":"flex items-center gap-2","children":[["$","$Le",null,{"href":"/","className":"py-2 transition-colors hover:text-ink","children":"Home"}],["$","span",null,{"aria-hidden":"true","children":"/"}]]}],["$","li","/insights",{"className":"flex items-center gap-2","children":[["$","$Le",null,{"href":"/insights","className":"py-2 transition-colors hover:text-ink","children":"Insight